# 环境变量清单 —— 只列名字与语义，不含任何真实密钥。
# 复制成 .env 后按需填写；.env 已被 .gitignore 排除，任何情况下不得入库。
#
# 默认模式（回放）不需要下面任何一个变量有值：
#   数据读 fixture、LLM 读录播、时钟取 fixture 锚点 —— 零配置即可产出日报。

# --- 两个独立的模式开关（ADR-0009）-------------------------------------------
# 各自取 replay | live，默认都是 replay。
# 分开的理由：调一句导读的措辞不该被迫把铜价源切到真实抓取（那要无头浏览器、要过 Cloudflare）。
MINING_DATA_MODE=replay
MINING_LLM_MODE=replay

# --- LLM（仅 MINING_LLM_MODE=live 时需要）------------------------------------
# DeepSeek 的 API 是 OpenAI 兼容的，因此复用 openai SDK，只需改 base_url。
MINING_LLM_API_KEY=
MINING_LLM_BASE_URL=https://api.deepseek.com
MINING_LLM_MODEL=deepseek-chat

# --- 抓取（仅 MINING_DATA_MODE=live 时需要）-----------------------------------
# 走代理时填这里（本机实测为 127.0.0.1:7897）；留空则不使用代理。
MINING_HTTP_PROXY=
# 带邮箱的 UA —— SEC EDGAR 等站点按规则要求，浏览器 UA 给 mining.com RSS 用。
MINING_USER_AGENT=mining-brief/0.1 (+contact@example.com)

# --- 超时（秒）。只放在配置入口，代码里不硬编码（ADR-0006）-------------------
MINING_HTTP_TIMEOUT=15
MINING_BROWSER_TIMEOUT=45

# --- fetch 节点的独立重试（工单 01 验收：各自独立超时与重试）------------------
# 只重试"工具链本身"的瞬时故障；数据源故障走降级信封，重试它们只是白等。
MINING_FETCH_ATTEMPTS=3
MINING_RETRY_BASE_DELAY=0.5

# --- 产物 ---------------------------------------------------------------------
# 日报落盘目录，跑完只把路径打到 stdout（PRD §5.3）。
MINING_OUTPUT_DIR=briefs
